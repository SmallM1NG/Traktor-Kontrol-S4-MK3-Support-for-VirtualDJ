  <UsingTask TaskName="S4GenerateIdentity" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup><Version ParameterType="System.String" Required="true"/><OutputDirectory ParameterType="System.String" Required="true"/></ParameterGroup>
    <Task><Using Namespace="System"/><Using Namespace="System.IO"/><Using Namespace="System.Text"/><Code Type="Fragment" Language="cs"><![CDATA[
      if (!System.Text.RegularExpressions.Regex.IsMatch(Version, @"^v\d+\.\d+\.\d+$")) { Log.LogError("S4Version must use vMAJOR.MINOR.PATCH."); return false; }
      Directory.CreateDirectory(OutputDirectory);
      var helper = "Traktor Kontrol S4 MK3 NI Service Helper " + Version + ".exe";
      var dll = "Traktor Kontrol S4 MK3 Bridge " + Version + ".dll";
      var text = "#pragma once\n#define S4_RELEASE_VERSION \""+Version+"\"\n#define S4_HELPER_EXE L\""+helper+"\"\n#define S4_PLUGIN_DLL L\""+dll+"\"\n#define S4_PLUGIN_NAME \"Traktor Kontrol S4 MK3 Bridge "+Version+"\"\n#define S4_RING_LOG L\"Traktor-Kontrol-S4-MK3-Bridge-"+Version+".log\"\n#define S4_PHASE_LOG L\"Traktor-Kontrol-S4-MK3-NI-Service-Helper-"+Version+".log\"\n";
      var path=Path.Combine(OutputDirectory,"release_identity.h");
      if(!File.Exists(path)||File.ReadAllText(path)!=text) File.WriteAllText(path,text,new UTF8Encoding(false));
      path=Path.Combine(OutputDirectory,"Bridge.def");text="EXPORTS\n    DllGetClassObject PRIVATE\n";
      if(!File.Exists(path)||File.ReadAllText(path)!=text) File.WriteAllText(path,text,new UTF8Encoding(false));
    ]]></Code></Task>
  </UsingTask>
  <UsingTask TaskName="S4GenerateHelperDigest" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup><HelperPath ParameterType="System.String" Required="true"/><OutputDirectory ParameterType="System.String" Required="true"/></ParameterGroup>
    <Task><Using Namespace="System"/><Using Namespace="System.IO"/><Using Namespace="System.Text"/><Code Type="Fragment" Language="cs"><![CDATA[
      if(!File.Exists(HelperPath)){Log.LogError("Build NI Service Helper before Bridge. Missing: "+HelperPath);return false;}
      string digest;using(var sha=System.Security.Cryptography.SHA256.Create())using(var input=File.OpenRead(HelperPath))digest=BitConverter.ToString(sha.ComputeHash(input)).Replace("-","").ToLowerInvariant();
      Directory.CreateDirectory(OutputDirectory);var path=Path.Combine(OutputDirectory,"release_digest.h");
      var text="#pragma once\ninline constexpr char NativeHelperSha256[]=\""+digest+"\";\n";
      if(!File.Exists(path)||File.ReadAllText(path)!=text) File.WriteAllText(path,text,new UTF8Encoding(false));
    ]]></Code></Task>
  </UsingTask>
